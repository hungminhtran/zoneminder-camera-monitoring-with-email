# Copy to .env and fill in real values:  cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never commit it.
#
# Read by Docker Compose via env_file, so it must be KEY=value with no spaces
# around "=", one setting per line, comments on their own line.

# --- ZoneMinder API ---
# Base URL without trailing slash. Include /zm if your install uses it.
# From inside a Docker container, ZoneMinder on the host is usually
# http://host.docker.internal:8080/zm
ZM_URL=http://10.66.66.2/zm
ZM_USER=admin
ZM_PASSWORD=change-me

# 1 = skip TLS certificate verification (self-signed certs only)
ZM_INSECURE=0

# --- Email (Gmail SMTP, implicit TLS on 465) ---
# EMAIL_PASS must be a 16-character App Password, not the account password:
# https://myaccount.google.com/apppasswords
# Google displays it as 4 groups of 4; the spaces are cosmetic and can be
# dropped, or the value can be quoted.
EMAIL_FROM=you@gmail.com
EMAIL_PASS="abcd efgh ijkl mnop"
EMAIL_TO=you@gmail.com

# --- Behaviour ---
# A camera alerts when its rolling average drops below this many FPS.
LOW_FPS_THRESHOLD=13

# How long samples are kept, and the timezone used in emails and charts.
RETENTION_DAYS=2
DISPLAY_TZ=Asia/Ho_Chi_Minh

# Host folder bind-mounted to /data. Defaults to the folder holding
# docker-compose.yml, so the database file appears right beside it:
#   DEV=1 -> ./dev_zoneminder_monitoring.db
#   DEV=0 -> ./prod_zoneminder_monitoring.db
DB_HOST_DIR=./

# Required to pause/resume email notifications from the UI.
# Leave empty and the control endpoint rejects every request.
PAUSE_PASSPHRASE=change-me-too

# --- Development ---
# DEV=1 uses dev_zoneminder_monitoring.db and seeds it with obviously fake data
# (SEED_cam_01..N, 100 fps, 1024 KB/s) plus a SAMPLE DATA bar.
# DEV=0 uses prod_zoneminder_monitoring.db and lets the collector create it.
DEV=0
SEED_CAMERAS=32
